@prefix ex: <https://example.invalid/ontology/> .
@prefix oa: <urn:ontology-agent:core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:MarkedSemanticElementShape a sh:NodeShape ;
    sh:targetClass oa:Concept, oa:Property, oa:Relation, oa:BusinessRule, oa:DataSource, oa:PhysicalMapping ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Marked semantic element requires a label"
    ] .
