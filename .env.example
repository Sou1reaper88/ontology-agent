# 环境分离：dev / staging / prod
ENV=dev
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__USER=ontology
DATABASE__PASSWORD=ontology
DATABASE__NAME=ontology_agent

# Redis（任务队列 / 缓存）
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0

# Hive 集群（执行 HiveSQL）
HIVE__HOST=localhost
HIVE__PORT=10000
HIVE__USER=hive
HIVE__DATABASE=default
HIVE__TIMEOUT_SECONDS=300

# 商业 LLM API（仅生成 SQL，执行与结果在本地不流出）
LLM__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM__API_KEY=your-api-key-here
LLM__MODEL=qwen2.5-coder-32b-instruct
LLM__TEMPERATURE=0.0
LLM__MAX_TOKENS=4096
LLM__CONTEXT_WINDOW_TOKENS=32768
LLM__CONTEXT_STATIC_PROMPT_RESERVE_TOKENS=8192
LLM__CONTEXT_COMPRESSION_TRIGGER_RATIO=0.8
LLM__CONTEXT_COMPRESSION_TARGET_RATIO=0.6
LLM__CONTEXT_KEEP_RECENT_TURNS=6

# 现有本体平台 API（4 个工具）
ONTOLOGY__BASE_URL=http://10.78.188.159:9080
ONTOLOGY__ONTOLOGY_ID=
ONTOLOGY__TIMEOUT_SECONDS=30
ONTOLOGY__PACKAGE_PATH=
ONTOLOGY__SHADOW_ENABLED=true

# Managed ontology state must be outside the source repository.
ONTOLOGY__MANAGEMENT_ROOT=D:/path/outside/repository/ontology-management
ONTOLOGY__MANAGEMENT_WORKSPACE=evaluation
